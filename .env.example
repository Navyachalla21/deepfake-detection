# Copy this file to .env and edit. Everything is optional for a local run.

# Keep the same value across restarts/workers so logins survive. Any long random string.
SECRET_KEY=change-me-to-a-long-random-string

# Max upload size in MB
MAX_UPLOAD_MB=100

# Storage for uploaded files: local | s3 | none
STORAGE_BACKEND=local
# S3_BUCKET=my-deepfake-bucket
# S3_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# MongoDB (leave commented to use the built-in local JSON store in instance/)
# MONGO_URI=mongodb://localhost:27017/
